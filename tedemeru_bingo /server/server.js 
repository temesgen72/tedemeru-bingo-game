// Deterministic 5x5 Bingo card generator for card numbers 1..999
function generateBingoCard(cardNumber) {
  let seed = cardNumber * 2654435761;
  const nextRand = () => {
    seed = (seed * 1664525 + 1013904223) % 4294967296;
    return seed / 4294967296;
  };

  const columns = [
    [1, 15],
    [16, 30],
    [31, 45],
    [46, 60],
    [61, 75]
  ];

  // grid[row][col] -> 5 rows x 5 cols
  const grid = Array.from({ length: 5 }, () => Array(5).fill(0));

  for (let col = 0; col < 5; col++) {
    const [min, max] = columns[col];
    const pool = [];
    for (let n = min; n <= max; n++) pool.push(n);

    for (let i = pool.length - 1; i > 0; i--) {
      const j = Math.floor(nextRand() * (i + 1));
      [pool[i], pool[j]] = [pool[j], pool[i]];
    }

    for (let row = 0; row < 5; row++) {
      if (row === 2 && col === 2) {
        grid[row][col] = 'FREE';
      } else {
        grid[row][col] = pool[row];
      }
    }
  }

  return grid;
}

function checkBingoWin(grid, calledSet) {
  const isMarked = (r, c) => grid[r][c] === 'FREE' || calledSet.has(grid[r][c]);

  // Rows & Columns
  for (let i = 0; i < 5; i++) {
    if ([0, 1, 2, 3, 4].every((c) => isMarked(i, c))) return true;
    if ([0, 1, 2, 3, 4].every((r) => isMarked(r, i))) return true;
  }

  // Diagonals
  if ([0, 1, 2, 3, 4].every((d) => isMarked(d, d))) return true;
  if ([0, 1, 2, 3, 4].every((d) => isMarked(d, 4 - d))) return true;

  return false;
}

// Player wallets keyed by socket.id (or persistent userKey)
const wallets = new Map();
function getWallet(key) {
  if (!wallets.has(key)) {
    wallets.set(key, { balance: 100.0, history: [] });
  }
  return wallets.get(key);
}

// Live Bingo Round State
let bingoState = {
  phase: 'BETTING', // 'BETTING' | 'DRAWING'
  roundNumber: 1214,
  timer: 15,
  potPrize: 2360.0,
  cardPrice: CARD_PRICE_ETB,
  takenCards: new Map(), // cardNumber -> { ownerKey, ownerName }
  calledNumbers: [],
  lastWinners: []
};

// Live Fast Keno State (1..80)
let kenoState = {
  roundNumber: 408,
  timer: 22,
  bets: [], // { socketId, userKey, numbers, stake }
  lastDrawn: [],
  lastResults: []
};

function startNewBingoRound() {
  bingoState.phase = 'BETTING';
  bingoState.roundNumber += 1;
  bingoState.timer = 15;
  bingoState.takenCards.clear();
  bingoState.calledNumbers = [];
  bingoState.lastWinners = [];
  io.emit('bingo_round_started', getPublicBingoState());
}

function drawNextBingoBall() {
  const remaining = [];
  for (let n = 1; n <= 75; n++) {
    if (!bingoState.calledNumbers.includes(n)) remaining.push(n);
  }

  if (remaining.length === 0 || bingoState.lastWinners.length > 0) {
    setTimeout(startNewBingoRound, 4000);
    return;
  }

  const ball = remaining[Math.floor(Math.random() * remaining.length)];
  bingoState.calledNumbers.push(ball);
  const calledSet = new Set(bingoState.calledNumbers);

  const winners = [];
  for (const [cardNum, entry] of bingoState.takenCards.entries()) {
    const cardGrid = generateBingoCard(cardNum);
    if (checkBingoWin(cardGrid, calledSet)) {
      winners.push({
        cardNumber: cardNum,
        userKey: entry.userKey,
        playerName: entry.playerName
      });
    }
  }

  if (winners.length > 0) {
    const payoutEach = Number((bingoState.potPrize / winners.length).toFixed(2));
    bingoState.lastWinners = winners.map((w) => ({ ...w, prize: payoutEach }));

    for (const w of winners) {
      const wallet = getWallet(w.userKey);
      wallet.balance = Number((wallet.balance + payoutEach).toFixed(2));
      wallet.history.unshift({
        id: `${Date.now()}-${w.cardNumber}`,
        title: `Bingo Win - Card #${w.cardNumber} (Round #${bingoState.roundNumber})`,
        amount: `+${payoutEach.toFixed(2)} ETB`,
        status: 'WON'
      });
    }

    io.emit('bingo_winner', {
      roundNumber: bingoState.roundNumber,
      winners: bingoState.lastWinners,
      calledNumbers: bingoState.calledNumbers
    });

    bingoState.potPrize = 500.0;
    setTimeout(startNewBingoRound, 5000);
  } else {
    io.emit('bingo_ball_called', {
      ball,
      calledNumbers: bingoState.calledNumbers,
      roundNumber: bingoState.roundNumber
    });
  }
}

function resolveKenoRound() {
  const pool = Array.from({ length: 80 }, (_, idx) => idx + 1);
  for (let i = pool.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [pool[i], pool[j]] = [pool[j], pool[i]];
  }
  const drawn = pool.slice(0, 20).sort((a, b) => a - b);
  const drawnSet = new Set(drawn);

  const results = kenoState.bets.map((bet) => {
    const hits = bet.numbers.filter((n) => drawnSet.has(n)).length;
    const multiplier = hits >= 5 ? hits * 2 : hits >= 3 ? 1.5 : 0;
    const payout = Number((bet.stake * multiplier).toFixed(2));

    if (payout > 0) {
      const wallet = getWallet(bet.userKey);
      wallet.balance = Number((wallet.balance + payout).toFixed(2));
      wallet.history.unshift({
        id: `${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
        title: `Fast Keno (${hits} hits / ${bet.numbers.length} picks)`,
        amount: `+${payout.toFixed(2)} ETB`,
        status: 'WON'
      });
    }

    return {
      userKey: bet.userKey,
      numbers: bet.numbers,
      hits,
      payout
    };
  });

  kenoState.lastDrawn = drawn;
  kenoState.lastResults = results;
  kenoState.bets = [];
  kenoState.roundNumber += 1;
  kenoState.timer = 22;

  io.emit('keno_round_result', {
    roundNumber: kenoState.roundNumber - 1,
    drawn,
    results
  });
}

function getPublicBingoState() {
  return {
    phase: bingoState.phase,
    roundNumber: bingoState.roundNumber,
    timer: bingoState.timer,
    potPrize: bingoState.potPrize,
    cardPrice: bingoState.cardPrice,
    takenCards: Array.from(bingoState.takenCards.keys()),
    calledNumbers: bingoState.calledNumbers,
    lastWinners: bingoState.lastWinners
  };
}

// 1-second authoritative loop for Bingo & Fast Keno
setInterval(() => {
  if (bingoState.phase === 'BETTING') {
    bingoState.timer -= 1;
    if (bingoState.timer <= 0) {
      bingoState.phase = 'DRAWING';
      bingoState.timer = 0;
      drawNextBingoBall();
    }
  } else if (bingoState.phase === 'DRAWING') {
    drawNextBingoBall();
  }

  kenoState.timer -= 1;
  if (kenoState.timer <= 0) {
    resolveKenoRound();
  }

  io.emit('timer_update', {
    bingo: getPublicBingoState(),
    keno: {
      roundNumber: kenoState.roundNumber,
      timer: kenoState.timer,
      lastDrawn: kenoState.lastDrawn
    }
  });
}, 1000);

io.on('connection', (socket) => {
  const defaultKey = socket.handshake.query.userKey || socket.id;
  const wallet = getWallet(defaultKey);

  socket.emit('init_state', {
    bingo: getPublicBingoState(),
    keno: {
      roundNumber: kenoState.roundNumber,
      timer: kenoState.timer,
      lastDrawn: kenoState.lastDrawn
    },
    wallet
  });

  socket.on('sync_user', ({ userKey }) => {
    const key = userKey || socket.id;
    socket.emit('wallet_update', getWallet(key));
  });

  socket.on('get_card_grid', ({ cardNumber }, cb) => {
    const num = Number(cardNumber);
    if (!Number.isInteger(num) || num < 1 || num > 999) {
      if (typeof cb === 'function') cb({ error: 'Invalid card number' });
      return;
    }
    if (typeof cb === 'function') {
      cb({ cardNumber: num, grid: generateBingoCard(num) });
    }
  });

  socket.on('buy_bingo_card', ({ cardNumber, userKey, playerName }, cb) => {
    const num = Number(cardNumber);
    const key = userKey || socket.id;
    const walletData = getWallet(key);

    if (bingoState.phase !== 'BETTING') {
      if (typeof cb === 'function') cb({ ok: false, error: 'ROUND_IN_PROGRESS' });
      return;
    }
    if (!Number.isInteger(num) || num < 1 || num > 999) {
      if (typeof cb === 'function') cb({ ok: false, error: 'INVALID_CARD' });
      return;
    }
    if (bingoState.takenCards.has(num)) {
      if (typeof cb === 'function') cb({ ok: false, error: 'CARD_TAKEN' });
      return;
    }
    if (walletData.balance < bingoState.cardPrice) {
      if (typeof cb === 'function') cb({ ok: false, error: 'INSUFFICIENT_BALANCE' });
      return;
    }

    walletData.balance = Number((walletData.balance - bingoState.cardPrice).toFixed(2));
    walletData.history.unshift({
      id: `${Date.now()}-${num}`,
      title: `Bingo Card #${num} (Round #${bingoState.roundNumber})`,
      amount: `-${bingoState.cardPrice.toFixed(2)} ETB`,
      status: 'ACTIVE'
    });

    bingoState.takenCards.set(num, {
      userKey: key,
      playerName: playerName || 'Player'
    });
    bingoState.potPrize = Number((bingoState.potPrize + bingoState.cardPrice * 0.8).toFixed(2));

    const grid = generateBingoCard(num);

    io.emit('card_reserved', {
      cardNumber: num,
      takenCards: Array.from(bingoState.takenCards.keys()),
      potPrize: bingoState.potPrize
    });

    socket.emit('wallet_update', walletData);

    if (typeof cb === 'function') {
      cb({ ok: true, cardNumber: num, grid, wallet: walletData });
    }
  });

  socket.on('place_keno_bet', ({ numbers, stake, userKey }, cb) => {
    const key = userKey || socket.id;
    const walletData = getWallet(key);
    const betStake = Number(stake) || 10;

    if (!Array.isArray(numbers) || numbers.length < 1 || numbers.length > 10) {
      if (typeof cb === 'function') cb({ ok: false, error: 'INVALID_NUMBERS' });
      return;
    }
    if (walletData.balance < betStake) {
      if (typeof cb === 'function') cb({ ok: false, error: 'INSUFFICIENT_BALANCE' });
      return;
    }

    walletData.balance = Number((walletData.balance - betStake).toFixed(2));
    walletData.history.unshift({
      id: `${Date.now()}-keno`,
      title: `Fast Keno Round #${kenoState.roundNumber} (${numbers.join(', ')})`,
      amount: `-${betStake.toFixed(2)} ETB`,
      status: 'WAITING'
    });

    kenoState.bets.push({
      socketId: socket.id,
      userKey: key,
      numbers: [...numbers],
      stake: betStake
    });

    socket.emit('wallet_update', walletData);
    if (typeof cb === 'function') {
      cb({ ok: true, wallet: walletData });
    }
  });

  socket.on('wallet_transaction', ({ type, method, amount, phone, accountName, userKey }, cb) => {
    const key = userKey || socket.id;
    const walletData = getWallet(key);
    const numericAmount = Number(amount);

    if (!numericAmount || numericAmount < 50 || numericAmount > 10000) {
      if (typeof cb === 'function') cb({ ok: false, error: 'INVALID_AMOUNT' });
      return;
    }

    if (type === 'deposit') {
      walletData.balance = Number((walletData.balance + numericAmount).toFixed(2));
      walletData.history.unshift({
        id: `${Date.now()}-dep`,
        title: `Deposit via ${String(method || 'telebirr').toUpperCase()}`,
        amount: `+${numericAmount.toFixed(2)} ETB`,
        status: 'CREDITED'
      });
    } else {
      if (walletData.balance < numericAmount) {
        if (typeof cb === 'function') cb({ ok: false, error: 'INSUFFICIENT_BALANCE' });
        return;
      }
      walletData.balance = Number((walletData.balance - numericAmount).toFixed(2));
      walletData.history.unshift({
        id: `${Date.now()}-wd`,
        title: `Withdraw via ${String(method || 'telebirr').toUpperCase()} (${phone || ''})`,
        amount: `-${numericAmount.toFixed(2)} ETB`,
        status: accountName ? `PENDING (${accountName})` : 'PENDING'
      });
    }

    socket.emit('wallet_update', walletData);
    if (typeof cb === 'function') {
      cb({ ok: true, wallet: walletData });
    }
  });
});

app.get('/health', (_req, res) => {
  res.json({ status: 'ok', service: 'tedemeru-bingo-server', round: bingoState.roundNumber });
});

server.listen(PORT, () => {
  console.log(`Tedemeru Bingo server listening on port ${PORT}`);
});